{
  "expo": {
    "name": "Workout",
    "slug": "workout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E0F",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.anay.workout",
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-notifications",
      "react-native-health-connect",
      [
        "@sfourdrinier/react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Allow Workout to read weight from your Bluetooth scale."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "manifestQueries": {
              "package": [
                "fit.cure.android.cswatch"
              ]
            },
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ]
    ],
    "scheme": "workout",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f083479a-2673-4bc9-bb22-7f9affdea7ff"
      }
    },
    "owner": "anay0305"
  }
}
